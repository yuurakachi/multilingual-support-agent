# Copy this file to .env and fill in your own values.
# .env is git-ignored and must never be committed.

# Your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Claude model used by the agent. Change it here, not in the code.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional. Thinking effort: low, medium, high, xhigh or max.
# Leave empty to use the API default, or for models without effort support.
ANTHROPIC_EFFORT=medium

# Optional. Maximum model calls per customer message (default 8).
AGENT_MAX_ITERATIONS=8

# --- Voice channel (python -m support_agent --voice) ---

# Free Groq API key for speech-to-text (https://console.groq.com/keys). No card needed.
GROQ_API_KEY=

# Speech-to-text model hosted by Groq.
STT_MODEL=whisper-large-v3-turbo

# Optional. Text-to-speech voice per language, replacing the default one.
# List the available voices with: edge-tts --list-voices
TTS_VOICE_ES=
TTS_VOICE_JA=
TTS_VOICE_EN=

# Optional. Recordings quieter than this are treated as silence and never sent to
# speech-to-text (default 200). The chat prints the level of a rejected recording:
# lower this if your voice is being rejected, raise it if room noise gets through.
VOICE_SILENCE_LEVEL=
