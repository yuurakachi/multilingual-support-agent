# Copy this file to .env and fill in your own values.
# .env is git-ignored and must never be committed.

# Your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Claude model used by the agent. Change it here, not in the code.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional. Thinking effort: low, medium, high, xhigh or max.
# Leave empty to use the API default, or for models without effort support.
ANTHROPIC_EFFORT=medium

# Optional. Maximum model calls per customer message (default 8).
AGENT_MAX_ITERATIONS=8
